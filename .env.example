# Karta pacienta – konfigurace serveru (na VPS ji při prvním nasazení vytvoří deploy/vps-deploy.sh)
PORT=3120
HOST=127.0.0.1
KP_VEREJNA_ADRESA=https://kartapacienta.95-216-201-2.sslip.io

# databáze PeceDomaPlus (stejné názvy jako v jhn-apps)
DB_PECEDOMAPLUS_SERVER=90.182.39.103
DB_PECEDOMAPLUS_PORT=1433
DB_PECEDOMAPLUS_DATABASE=PeceDomaPlus
DB_PECEDOMAPLUS_USER=pecedomaplus_app
DB_PECEDOMAPLUS_PASSWORD=

# klíč k podpisu session a šifrování tajemství telefonů (min. 32 znaků, NEMĚNIT za provozu –
# spárované telefony by přestaly dostávat kód lékaře)
KP_SECRET=
# heslo do správy tenantů (/tenanti/)
KP_ADMIN_HESLO=

# AI rozbor propouštěcích zpráv (jen anonymizovaný text); bez klíče běží lokální rozbor
ANTHROPIC_API_KEY=
KP_AI_MODEL=claude-sonnet-5-5

# SMS s odkazem na spárování telefonu s kartou (Twilio; deploy je převezme z /opt/jhn-apps/.env).
# Bez nich se párovací odkaz neposílá SMS – telefon se spáruje QR kódem a potvrdí své číslo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
